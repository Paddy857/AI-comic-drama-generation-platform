<mxfile host="app.diagrams.net" agent="manual">
  <diagram id="er-diagram" name="图5-1 ER图">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 实体 -->
        <mxCell id="users" value="USERS（用户）&#xa;id PK&#xa;username UK&#xa;hashed_password&#xa;nickname&#xa;is_vip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="projects" value="PROJECTS（项目）&#xa;id PK&#xa;title&#xa;category&#xa;style&#xa;status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="templates" value="TEMPLATES（模板）&#xa;id PK&#xa;template_code UK&#xa;name&#xa;total_shots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gen_tasks" value="GENERATION_TASKS（生成任务）&#xa;id PK&#xa;project_id FK&#xa;template_id FK&#xa;status / progress&#xa;video_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="200" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gen_shots" value="GENERATED_SHOTS（产出分镜）&#xa;id PK&#xa;task_id FK&#xa;shot_no&#xa;image_url / audio_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="200" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tpl_vars" value="TEMPLATE_VARIABLES&#xa;id PK&#xa;template_id FK&#xa;var_key / var_label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tpl_shots" value="TEMPLATE_SHOTS（模板分镜）&#xa;id PK&#xa;template_id FK&#xa;shot_no / script_content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#d97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="favorites" value="USER_FAVORITES（收藏）&#xa;id PK&#xa;user_id FK&#xa;template_id FK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="chars" value="CHARACTERS（角色）&#xa;id PK&#xa;project_id FK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="380" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="scenes" value="SCENES（场景）&#xa;id PK&#xa;project_id FK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="380" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="shots" value="SHOTS（分镜）&#xa;id PK&#xa;project_id FK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="380" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="assets" value="ASSETS（素材）&#xa;id PK&#xa;user_id FK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- 关系线 -->
        <mxCell id="r1" value="1:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="users" target="projects" />
        <mxCell id="r2" value="1:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="users" target="assets" />
        <mxCell id="r3" value="M:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;dashed=1;" edge="1" parent="1" source="users" target="favorites" />
        <mxCell id="r4" value="M:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;dashed=1;" edge="1" parent="1" source="templates" target="favorites" />
        <mxCell id="r5" value="1:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="templates" target="tpl_vars" />
        <mxCell id="r6" value="1:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="templates" target="tpl_shots" />
        <mxCell id="r7" value="1:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="projects" target="gen_tasks" />
        <mxCell id="r8" value="N:1" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="gen_tasks" target="templates" />
        <mxCell id="r9" value="1:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="gen_tasks" target="gen_shots" />
        <mxCell id="r10" value="1:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="projects" target="chars" />
        <mxCell id="r11" value="1:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="projects" target="scenes" />
        <mxCell id="r12" value="1:N" style="endArrow=block;startArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="projects" target="shots" />
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
