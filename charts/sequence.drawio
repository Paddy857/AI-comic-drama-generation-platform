<mxfile host="app.diagrams.net" agent="manual">
  <diagram id="sequence" name="图3-3 AI图像生成时序图">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 参与者 -->
        <mxCell id="a1" value="前端 (Vue)" style="shape=actor;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="40" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="后端 (FastAPI)" style="shape=actor;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="40" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="任务状态机" style="shape=actor;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="40" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="文生图服务" style="shape=actor;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="20" width="40" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="数据库/文件" style="shape=actor;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="20" width="40" height="50" as="geometry" />
        </mxCell>

        <!-- 生命线 -->
        <mxCell id="l1" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="100" as="sourcePoint" />
            <mxPoint x="80" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l2" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="100" as="sourcePoint" />
            <mxPoint x="300" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l3" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="100" as="sourcePoint" />
            <mxPoint x="520" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l4" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="100" as="sourcePoint" />
            <mxPoint x="740" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l5" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="100" as="sourcePoint" />
            <mxPoint x="960" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 消息 -->
        <mxCell id="m1" value="POST /api/generate/ 创建任务" style="html=1;fontSize=11;strokeColor=#334155;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="130" as="sourcePoint" />
            <mxPoint x="300" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="后台线程启动五步管线" style="html=1;fontSize=11;strokeColor=#334155;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="180" as="sourcePoint" />
            <mxPoint x="520" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="step3 分镜批量绘图" style="html=1;fontSize=11;strokeColor=#334155;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="230" as="sourcePoint" />
            <mxPoint x="740" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="loop 每镜生成 720x1280 图" style="html=1;fontSize=11;strokeColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="280" as="sourcePoint" />
            <mxPoint x="960" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="回写 image_url" style="html=1;fontSize=11;strokeColor=#334155;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="330" as="sourcePoint" />
            <mxPoint x="520" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="GET /api/generate/tasks/{id} 2s 轮询" style="html=1;fontSize=11;strokeColor=#334155;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="390" as="sourcePoint" />
            <mxPoint x="300" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="返回 {progress, current_step, shots[]}" style="html=1;fontSize=11;strokeColor=#334155;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="440" as="sourcePoint" />
            <mxPoint x="80" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="step5 配音+渲染，写回 video_url" style="html=1;fontSize=11;strokeColor=#334155;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="520" y="500" as="sourcePoint" />
            <mxPoint x="960" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="轮询到 done，展示视频成品" style="html=1;fontSize=11;strokeColor=#334155;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="560" as="sourcePoint" />
            <mxPoint x="80" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
