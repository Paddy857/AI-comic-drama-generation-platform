        <mxCell id="s6" value="⑤ Ken Burns 运镜&#xa;+ 字幕烧录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="120" width="130" height="60" as="geometry" />
