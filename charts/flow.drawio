        <mxCell id="s7" value="⑥ 完整漫剧视频&#xa;（concat 拼接）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1">
