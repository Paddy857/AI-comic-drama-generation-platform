# =============================================================
# AI漫剧制作平台 环境配置模板
# 复制为 .env 后按需修改：cp .env.example .env
# =============================================================

# ---------- 数据库（默认 SQLite，零配置即可运行） ----------
DB_TYPE=sqlite            # sqlite | mysql（使用 MySQL 时填写下方 5 项）
SQLITE_PATH=aigc.db

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aigc_db

# ---------- 认证 ----------
SECRET_KEY=aigc-super-secret-key-2026-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 文件存储 ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800    # 上传限制 50MB

# =============================================================
# 模型 API 配置（三大引擎，均可独立开关）
# =============================================================

# ---------- ① 语音合成 TTS ----------
# 免费在线引擎（无需申请任何 Key，开箱即用）：
#   edge         : 微软 Edge-TTS（默认，推荐；免费高质量中文，需外网）
#   pollinations : Pollinations.ai 在线 TTS（备选；该公共端点可能受限/404，可用时免 Key）
# 兜底/演示引擎：
#   silence      : 静音音频（跨平台兜底，无配音但能出片）
#   mock         : 纯模拟（返回演示 URL，不落盘）
#   say          : macOS 系统离线语音（仅本机演示用）
# 真实厂商引擎（申请到 API 后接入，实现类注册后即可用）：
#   aliyun / cosyvoice / volcengine / elevenlabs
TTS_ENGINE=edge
POLLINATIONS_TTS_BASE_URL=https://text.pollinations.ai
POLLINATIONS_TTS_TIMEOUT=90        # 单次合成超时（秒）

# 接入阿里云 TTS 时（示例，需在 services/tts/ 下实现 aliyun 引擎）：
# TTS_ENGINE=aliyun
# ALIYUN_TTS_ACCESS_KEY_ID=xxxx
# ALIYUN_TTS_ACCESS_KEY_SECRET=xxxx
# ALIYUN_TTS_APPKEY=xxxx

# 接入火山引擎 CosyVoice 时（示例）：
# TTS_ENGINE=cosyvoice
# VOLC_ACCESS_KEY=xxxx
# VOLC_SECRET_KEY=xxxx
# VOLC_APP_ID=xxxx

# ---------- ② 文生图 ----------
# pollinations : 免费真实文生图（推荐，需外网；失败自动回落本地占位图）
# local        : 完全离线（Pillow 本地渲染，无网络也能出图，适合评测/演示环境）
# mock         : 本地模拟（返回占位 URL）
IMAGE_GEN_ENGINE=pollinations
POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_TIMEOUT=180     # 单张生成超时（秒）
IMAGE_CONCURRENCY=1          # 并发出图数（免费服务建议 1，稳定优先）

# 接入硅基流动·可图 Kolors 时（更快的真实出图，需注册 https://siliconflow.cn 获取 Key）：
# IMAGE_GEN_ENGINE=kolors
# KOLORS_API_KEY=sk-xxxx
# KOLORS_BASE_URL=https://api.siliconflow.cn/v1

# 接入智谱 CogView 时：
# IMAGE_GEN_ENGINE=cogview
# ZHIPU_API_KEY=xxxx

# ---------- ③ 剧本大模型 LLM（可选，模板驱动无需 LLM 也能跑通） ----------
# 用于 AI 剧本生成/变量智能补全，未配置时自动降级为本地模板渲染
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 使用硅基流动兼容接口（可同时支撑 LLM + 文生图）：
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
